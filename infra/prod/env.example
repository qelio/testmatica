# Переменные боевого окружения. На сервере — файл .env рядом с compose.prod.yaml (права 600, в git не кладём).
# Значения S3_*, REGISTRY выдаёт Terraform (infra/terraform, terraform output); секреты, в том числе пароли баз,
# генерирует infra/prod/gen-secrets.sh.

DOMAIN=testmatica.ru
LIVEKIT_DOMAIN=live.testmatica.ru
ACME_EMAIL=info@testmatica.ru

# Реестр образов (Yandex Container Registry) и версия (тег = коммит; GitHub Actions подставляет сам).
REGISTRY=cr.yandex/<id-реестра>
TAG=latest

# PostgreSQL в контейнере на ВМ (решение №38): пароль администратора и пароли пользователей сервисов.
PG_ADMIN_PASSWORD=
PG_PASSWORD_IDENTITY=
PG_PASSWORD_NOTIFICATION=
PG_PASSWORD_AUDIT=
PG_PASSWORD_CLASSROOM=
PG_PASSWORD_SCHEDULE=
PG_PASSWORD_ACADEMIC=
PG_PASSWORD_CHAT=
PG_PASSWORD_MEDIA=
PG_PASSWORD_CONTENT=
PG_PASSWORD_MODERATION=
PG_PASSWORD_ASSESSMENT=
PG_PASSWORD_MARKETPLACE=
PG_PASSWORD_BILLING=
PG_PASSWORD_VIDEO=
PG_PASSWORD_WHITEBOARD=

# Object Storage: статический ключ сервисного аккаунта и бакеты.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_FILES=testmatica-files
S3_BUCKET_RECORDINGS=testmatica-recordings

# Почта — Yandex Cloud Postbox (SMTP): идентификатор и секрет API-ключа сервисного аккаунта.
# EMAIL_ENABLED=false — почтового сервера пока нет (решение №29): регистрация без подтверждения email,
# вход без кода, сброс и смена email — «скоро». Включить после подтверждения домена в Postbox.
EMAIL_ENABLED=false
SMTP_USERNAME=
SMTP_PASSWORD=

# Секреты платформы (gen-secrets.sh).
INTERNAL_TOKEN=
IDENTITY_SECRET_KEY=
RABBITMQ_PASSWORD=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Оплата тарифа: disabled — до подключения ЮKassa (тариф выдаёт администратор).
PAYMENT_PROVIDER=disabled
