# Переменные боевого окружения. На сервере — файл .env рядом с compose.prod.yaml (права 600, в git не кладём).
# Значения PG_*, S3_*, REGISTRY выдаёт Terraform (infra/terraform, terraform output); секреты генерирует
# infra/prod/gen-secrets.sh.

DOMAIN=tmatica.ru
LIVEKIT_DOMAIN=live.tmatica.ru
ACME_EMAIL=info@tmatica.ru

# Реестр образов (Yandex Container Registry) и версия (тег = коммит; GitHub Actions подставляет сам).
REGISTRY=cr.yandex/<id-реестра>
TAG=latest

# Managed PostgreSQL: хост кластера и пароли пользователей сервисов.
PG_HOST=c-<id-кластера>.rw.mdb.yandexcloud.net
PG_PASSWORD_IDENTITY=
PG_PASSWORD_NOTIFICATION=
PG_PASSWORD_AUDIT=
PG_PASSWORD_CLASSROOM=
PG_PASSWORD_SCHEDULE=
PG_PASSWORD_ACADEMIC=
PG_PASSWORD_CHAT=
PG_PASSWORD_MEDIA=
PG_PASSWORD_CONTENT=
PG_PASSWORD_MODERATION=
PG_PASSWORD_ASSESSMENT=
PG_PASSWORD_MARKETPLACE=
PG_PASSWORD_BILLING=
PG_PASSWORD_VIDEO=

# Object Storage: статический ключ сервисного аккаунта и бакеты.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_FILES=tmatica-files
S3_BUCKET_RECORDINGS=tmatica-recordings

# Почта — Yandex Cloud Postbox (SMTP): идентификатор и секрет API-ключа сервисного аккаунта.
SMTP_USERNAME=
SMTP_PASSWORD=

# Секреты платформы (gen-secrets.sh).
INTERNAL_TOKEN=
IDENTITY_SECRET_KEY=
RABBITMQ_PASSWORD=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Оплата тарифа: disabled — до подключения ЮKassa (тариф выдаёт администратор).
PAYMENT_PROVIDER=disabled
